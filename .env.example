# Local or hosted Supabase public browser configuration.
# Use the publishable key for new projects; the legacy anon key also works during migration.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_LOCAL_KEY

# For a hosted project, replace both values with the project's URL and publishable key.
# Never put a secret/service_role key in a VITE_ variable or browser code.
